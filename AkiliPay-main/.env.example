# Copy to .env and fill in your values.
# FOREX_API_KEY is required for currency conversion (USD, JPY, GBP, EUR, ZAR).
# Get a free key at https://www.exchangerate-api.com/
FOREX_API_KEY=9d92d56f1f641d7fc3e72394

# Optional: base currency for stored amounts (default KES)
# BASE_CURRENCY=KES

# Optional: override API URL (default uses ExchangeRate-API v6 with KES base)
# FOREX_API_BASE_URL=https://v6.exchangerate-api.com/v6/{api_key}/latest/KES
